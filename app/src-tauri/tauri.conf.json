{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DynoTranslate",
  "version": "1.0.0",
  "identifier": "app.lumen.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "src-tauri\\bundle-runtime.cmd",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DynoTranslate",
        "width": 1100,
        "height": 760,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "tooltip": "DynoTranslate",
      "title": "DynoTranslate"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": {
      "resources/DirectML.dll": "DirectML.dll"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "wix": { "language": "en-US" },
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "globalShortcut": {
      "enabled": true
    },
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGMjM4QUM1QkUyQTBFM0MKUldROERpcSt4WW9qcjJ5TS9zUFBMaEFVTDRaMlNiOEdGbmVMZDd4aTc5NlFmUDlhbHpRNGhzUXMK",
      "endpoints": [
        "https://github.com/semishnikov/DynoTranslate/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
